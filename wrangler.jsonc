{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gestione-personale",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-26",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	// Ambiente di default (nessun --env): PRODUZIONE.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gestione-personale-db",
			"database_id": "7399c2ba-7a4b-4c45-8c6e-b4c6122cc241"
		}
	],
	"kv_namespaces": [
		{
			"binding": "ALLEGATI",
			"id": "5d0ad940fa5a46d28fc4894be19d37ab"
		}
	],
	// Ambiente di sviluppo: `wrangler deploy --env dev`. Worker, database e
	// KV separati da quelli di produzione, così i test non toccano i dati veri.
	"env": {
		"dev": {
			"name": "gestione-personale-dev",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gestione-personale-db-dev",
					"database_id": "779221e5-1b67-46a7-8657-4c617303deb6"
				},
				{
					// Accesso di sola lettura (per convenzione: nel codice non ci si scrive mai)
					// al database di produzione, usato solo dalla sincronizzazione dati riservata
					// al superadmin. Esiste solo qui: il Worker di produzione non ha questo binding.
					"binding": "DB_PROD",
					"database_name": "gestione-personale-db",
					"database_id": "7399c2ba-7a4b-4c45-8c6e-b4c6122cc241"
				}
			],
			"kv_namespaces": [
				{
					"binding": "ALLEGATI",
					"id": "2dfd2d62073b4849a31902d546eb5ce1"
				}
			]
		}
	}
}