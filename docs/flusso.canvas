			"y": 3370,
			"width": 260,
			"height": 140
		},
		{
			"id": "p-chat-1",
			"type": "text",
			"text": "**2.** Si apre il Consenso: solo lettura, o anche scrittura",
			"x": 320,
			"y": 3370,
			"width": 260,
			"height": 140
		},
		{
			"id": "p-chat-2",
			"type": "text",
			"text": "**3.** Consenti → torni alla chat",
			"x": 640,
			"y": 3370,
			"width": 260,
			"height": 140
		},
		{
			"id": "p-chat-3",
			"type": "text",
			"text": "**4.** Chiedi del diario o del peso; se può scrivere, segna pasti e pesate",
			"x": 960,
			"y": 3370,
			"width": 260,
			"height": 140
		},
		{
			"id": "p-chat-4",
			"type": "text",
			"text": "**5.** Impostazioni › Profilo: vedi il permesso di ognuna e la stacchi",
