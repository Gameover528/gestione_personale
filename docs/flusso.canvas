			"y": 3110,
			"width": 260,
			"height": 140
		},
		{
			"id": "p-peso-3",
			"type": "text",
			"text": "**4.** Usato dagli obiettivi e dalle calorie degli allenamenti",
			"x": 960,
			"y": 3110,
			"width": 260,
			"height": 140
		},
		{
			"id": "p-chat-0",
			"type": "text",
			"text": "**1.** In claude.ai, aggiungi il connettore dell'app",
